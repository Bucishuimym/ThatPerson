{
  "name": "@nineteenfolk/thatperson",
  "version": "1.1.0",
  "description": "ThatPerson - 无限接近人的个人 AI 管家（API=大脑 / skill=手 / Markdown=记忆）",
  "main": "dist/src/index.js",
  "bin": {
    "thatperson": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file=.env dist/src/index.js",
    "start": "node --env-file=.env dist/src/index.js",
    "mock": "tsc -p tsconfig.build.json && node dist/src/index.js --mock",
    "chat": "tsc -p tsconfig.build.json && node dist/src/cli.js",
    "chat:mock": "tsc -p tsconfig.build.json && node dist/src/cli.js --mock",
    "test": "tsc --noEmit && tsc -p tsconfig.test.json && node --test \"dist-test/tests/*.test.js\"",
    "report": "tsc -p tsconfig.build.json && node dist/src/report.js",
    "prepublishOnly": "npm run build && npm.cmd test"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "figlet": "^1.11.4",
    "inquirer": "^14.0.2",
    "log-symbols": "^7.0.1",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
